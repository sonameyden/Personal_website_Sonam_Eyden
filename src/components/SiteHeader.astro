---
import { person } from '../data/resume';
import { url } from '../lib/url';

// The home page header: sits in place at the top, hides as you scroll down,
// and slides back (on a solid ground) as soon as you scroll up. On phones the
// section links fold into a menu.
const links = [
  { href: '#work', label: 'Work' },
  { href: '#research', label: 'Research' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];
---

<div class="site-head no-print" data-head>
  <nav class="bar wrap" aria-label="Sections">
    <a class="home" href="#top">{person.name}</a>
    <ul class="inline">
      {links.map((l) => <li><a href={l.href} data-section-link>{l.label}</a></li>)}
    </ul>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open menu" data-menu-btn>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path class="l1" d="M4 8h16" />
        <path class="l2" d="M4 16h16" />
      </svg>
    </button>
  </nav>
  <div class="menu" id="site-menu" hidden data-menu>
    <ul class="wrap">
      {links.map((l) => <li><a href={l.href} data-section-link>{l.label}</a></li>)}
      <li><a href={url('sonam-eyden-resume.pdf')} download>Resume (PDF)</a></li>
    </ul>
  </div>
</div>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 20;
    transition:
      transform 0.45s var(--ease-out),
      background-color 0.3s,
      border-color 0.3s;
    border-bottom: 1px solid transparent;
  }

  .site-head.is-solid {
    background: color-mix(in oklab, var(--bg) 94%, transparent);
    border-bottom-color: var(--line);
  }

  .site-head.is-hidden {
    transform: translateY(-100%);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 4rem;
    font-size: 0.9375rem;
  }

  .home {
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }

  .inline {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .inline a,
  .menu a {
    position: relative;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .inline a:hover,
  .inline a[aria-current='true'] {
    color: var(--text);
  }

  /* The section you are reading gets the signature hairline beneath it. */
  .inline a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: var(--flow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }

  .inline a[aria-current='true']::after,
  .inline a:hover::after,
  .inline a:focus-visible::after {
    transform: scaleX(1);
  }

  .menu-btn {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.6rem;
    padding: 0.6rem;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--text);
    cursor: pointer;
  }

  .menu-btn svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .menu-btn path {
    transform-origin: 12px 12px;
    transition: transform 0.35s var(--ease-out);
  }

  .menu-btn[aria-expanded='true'] .l1 {
    transform: translateY(4px) rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] .l2 {
    transform: translateY(-4px) rotate(-45deg);
  }

  .menu {
    background: color-mix(in oklab, var(--bg) 96%, transparent);
    border-bottom: 1px solid var(--line);
  }

  .menu ul {
    list-style: none;
    padding: var(--space-2) 0 var(--space-5);
    margin: 0 auto;
    display: grid;
  }

  .menu a {
    display: block;
    padding: var(--space-3) 0;
    font-size: var(--step-1);
    color: var(--text);
    border-top: 1px solid var(--line);
  }

  .menu li:first-child a {
    border-top: 0;
  }

  @media (max-width: 720px) {
    .inline {
      display: none;
    }

    .menu-btn {
      display: block;
    }
  }

  @media (min-width: 721px) {
    .menu {
      display: none;
    }
  }
</style>

<script>
  const head = document.querySelector<HTMLElement>('[data-head]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (head && btn && menu) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
      head.classList.toggle('is-solid', open || window.scrollY > 24);
      if (open) head.classList.remove('is-hidden');
    };
    btn.addEventListener('click', () => setOpen(menu.hidden));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        btn.focus();
      }
    });

    // Hide while scrolling down, return on the way up.
    let lastY = window.scrollY;
    let ticking = false;
    const onScroll = () => {
      const y = window.scrollY;
      const open = !menu.hidden;
      head.classList.toggle('is-solid', y > 24 || open);
      if (!open && !head.contains(document.activeElement)) {
        if (y > lastY + 6 && y > 160) head.classList.add('is-hidden');
        else if (y < lastY - 6 || y <= 160) head.classList.remove('is-hidden');
      }
      lastY = y;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      },
      { passive: true },
    );
    head.addEventListener('focusin', () => head.classList.remove('is-hidden'));
    onScroll();

    // Mark the section being read.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.inline [data-section-link]')];
    const sections = links
      .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!))
      .filter((s): s is HTMLElement => !!s);
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((a) => a.setAttribute('aria-current', String(a.getAttribute('href') === `#${e.target.id}`)));
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => spy.observe(s));
  }
</script>
