---
interface Props {
  /** Share of the full line count to draw (1 on the home page). */
  density?: number;
  /** Keep the lines further right, clear of a wide text column. */
  quiet?: boolean;
}
const { density = 1, quiet = false } = Astro.props;
// The site's background: fine streamlines of a slow-moving flow field in the
// aqua → blue → violet blend, fixed behind every page. Light travels along the
// lines on its own; an invisible current drifts through the field so it keeps
// bending without any input; a mouse takes over that current on desktop; and
// scrolling moves the flow. Strongest at the top of the page, quieter once
// you scroll into the content. Draws one still frame under
// prefers-reduced-motion and pauses in a background tab.
---

<canvas class="flow" class:list={{ quiet }} aria-hidden="true" data-flow data-density={density}></canvas>

<style>
  .flow {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.6s var(--ease-out);
    -webkit-mask-image: linear-gradient(100deg, transparent 8%, #000 52%);
    mask-image: linear-gradient(100deg, transparent 8%, #000 52%);
  }

  .flow.quiet {
    -webkit-mask-image: linear-gradient(100deg, transparent 50%, #000 78%);
    mask-image: linear-gradient(100deg, transparent 50%, #000 78%);
  }

  .flow.is-ready {
    opacity: var(--flow-o, 1);
    transition: opacity 0.4s linear;
  }

  /* Phones: the text spans the full width, so the field gathers in the
     top-right corner of the screen. */
  @media (max-width: 720px) {
    .flow,
    .flow.quiet {
      -webkit-mask-image: radial-gradient(ellipse 85% 44% at 100% 0%, #000 22%, transparent 100%);
      mask-image: radial-gradient(ellipse 85% 44% at 100% 0%, #000 22%, transparent 100%);
    }
  }

  @media print {
    .flow {
      display: none;
    }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-flow]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const still = document.documentElement.classList.contains('still');
    const reduce = { get matches() { return still || mq.matches; } };
    let w = 0;
    let h = 0;
    let narrow = false;
    let seeds: { x: number; y: number }[] = [];
    let gradient: CanvasGradient | null = null;
    let raf = 0;
    let last = 0;
    let mouseActive = false;
    let scroll = window.scrollY;
    let scrollEased = scroll;
    // The current that bends the lines: a mouse on desktop, otherwise a slow drift.
    const pointer = { x: -9999, y: -9999, tx: -9999, ty: -9999 };
    const STEP = 9;

    // Deterministic pseudo-random so the composition is the same every visit.
    let s = 7;
    const rand = () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646;

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = document.documentElement.clientWidth;
      h = window.innerHeight;
      narrow = w < 720;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      gradient = ctx!.createLinearGradient(narrow ? 0 : w * 0.25, 0, w, h * 0.7);
      gradient.addColorStop(0, '#5ee0d0');
      gradient.addColorStop(0.5, '#7aa0ff');
      gradient.addColorStop(1, '#b7a0ff');

      const density = Number(canvas!.dataset.density || 1);
      s = 7;
      if (narrow) {
        // Start lines off the left edge so they sweep across the whole screen.
        const count = Math.round(54 * density);
        seeds = Array.from({ length: count }, () => {
          const u = rand();
          const v = rand();
          return { x: w * (u * 1.3 - 0.6), y: h * (v * 0.75 - 0.1) };
        });
      } else {
        // Seeds lean to the top-right, where the field is densest.
        const count = Math.round(84 * density);
        seeds = Array.from({ length: count }, () => {
          const u = rand();
          const v = rand();
          return { x: w * (0.15 + 0.9 * Math.sqrt(u)) - w * 0.1, y: h * v * v * 1.15 - h * 0.05 };
        });
      }
    }

    function angle(x: number, y: number, t: number) {
      // Scale the field to the screen so narrow screens get the same curvature.
      const k = narrow ? 2.2 : 1;
      let a =
        0.25 +
        0.85 * Math.sin(x * 0.0017 * k + t) * Math.cos(y * 0.0023 * k - t * 0.7) +
        0.35 * Math.sin((x + y) * 0.0011 * k - t * 0.4);
      const dx = x - pointer.x;
      const dy = y - pointer.y;
      const d2 = dx * dx + dy * dy;
      const r = narrow ? 150 : 190;
      if (d2 < r * r) {
        const f = 1 - Math.sqrt(d2) / r;
        a += f * f * 1.4 * (dy >= 0 ? 1 : -1);
      }
      return a;
    }

    function trace(t: number) {
      const paths: Path2D[] = [];
      const steps = narrow ? 110 : 100;
      for (const seed of seeds) {
        const p = new Path2D();
        let x = seed.x;
        let y = seed.y;
        p.moveTo(x, y);
        for (let i = 0; i < steps; i++) {
          const a = angle(x, y, t);
          x += Math.cos(a) * STEP;
          y += Math.sin(a) * STEP;
          p.lineTo(x, y);
          if (x > w + 40 || y > h + 40 || y < -40) break;
        }
        paths.push(p);
      }
      return paths;
    }

    // Full strength over the first screen, settling to a quiet presence below.
    function updateOpacity() {
      const fade = Math.min(1, scroll / (h * 0.9));
      const floor = narrow ? 0.34 : 0.32;
      canvas!.style.setProperty('--flow-o', String(1 - (1 - floor) * fade));
    }

    function draw(time: number) {
      // Scrolling moves the field forward, eased so it never jumps.
      scrollEased += (scroll - scrollEased) * 0.08;
      const t = time * (narrow ? 0.00006 : 0.00004) + scrollEased * 0.0007;

      if (!mouseActive) {
        // A slow current drifting through the upper right of the field.
        pointer.tx = w * (0.62 + 0.28 * Math.sin(time * 0.00021));
        pointer.ty = h * (0.3 + 0.2 * Math.sin(time * 0.00017 + 1.3));
      }
      if (pointer.x < -9000) {
        pointer.x = pointer.tx;
        pointer.y = pointer.ty;
      }
      pointer.x += (pointer.tx - pointer.x) * 0.06;
      pointer.y += (pointer.ty - pointer.y) * 0.06;

      ctx!.clearRect(0, 0, w, h);
      const paths = trace(t);
      ctx!.lineCap = 'round';
      ctx!.strokeStyle = gradient!;

      const isStill = reduce.matches;
      ctx!.globalAlpha = isStill ? 0.3 : narrow ? 0.2 : 0.16;
      ctx!.lineWidth = 1;
      ctx!.setLineDash([]);
      for (const p of paths) ctx!.stroke(p);
      // Without motion, the travelling light would freeze into dashes; draw the lines alone.
      if (isStill) {
        ctx!.globalAlpha = 1;
        return;
      }

      ctx!.globalAlpha = narrow ? 0.85 : 0.75;
      ctx!.lineWidth = narrow ? 1.6 : 1.4;
      ctx!.setLineDash(narrow ? [26, 200] : [22, 260]);
      ctx!.lineDashOffset = -time * 0.05 - scrollEased * 0.5;
      for (const p of paths) ctx!.stroke(p);
      ctx!.globalAlpha = 1;
    }

    function loop(time: number) {
      // Phones draw at 30 fps to save battery; the motion is slow enough not to show it.
      if (!narrow || time - last > 32) {
        last = time;
        draw(time);
      }
      raf = !document.hidden ? requestAnimationFrame(loop) : 0;
    }

    function start() {
      cancelAnimationFrame(raf);
      raf = 0;
      if (reduce.matches) {
        draw(0);
      } else {
        raf = requestAnimationFrame(loop);
      }
    }

    resize();
    updateOpacity();
    start();
    requestAnimationFrame(() => canvas.classList.add('is-ready'));

    let lastW = w;
    window.addEventListener('resize', () => {
      // Mobile browsers resize as the address bar shows and hides; only
      // rebuild when the width or the height really changes.
      if (document.documentElement.clientWidth === lastW && Math.abs(window.innerHeight - h) < 120) return;
      lastW = document.documentElement.clientWidth;
      resize();
      if (reduce.matches || !raf) draw(0);
    });

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && !reduce.matches) start();
    });
    mq.addEventListener('change', start);

    window.addEventListener(
      'scroll',
      () => {
        scroll = window.scrollY;
        updateOpacity();
        if (reduce.matches) return;
      },
      { passive: true },
    );

    // Only a real mouse or pen steers the current; touches are for scrolling.
    window.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      mouseActive = true;
      pointer.tx = e.clientX;
      pointer.ty = e.clientY;
    });
    document.documentElement.addEventListener('pointerleave', () => {
      mouseActive = false;
    });
  }
</script>
