---
// A two-page printable resume generated from the same data as the website.
// The deploy workflow prints this page to /sonam-eyden-resume.pdf on every
// push, so the PDF never drifts from the site. No phone number, ever.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import { person, work, experience, publications, moreProjects, skills, education } from '../data/resume';

const site = new URL(import.meta.env.BASE_URL, Astro.site).href.replace(/\/$/, '');
const bare = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '');
const byWork = Object.fromEntries(work.map((w) => [w.slug, w]));

// The strongest points from each work page, in the order a reader needs them.
const pick: Record<string, number[]> = {
  'calibration-co-pilot': [1, 2, 3],
  toursync: [0, 3, 1],
  drukserenity: [0, 1, 3],
};
const intake = byWork['document-intake-agent'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{person.name} · Resume</title>
    <meta name="description" content={`Resume of ${person.name}, ${person.role}.`} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main class="sheet">
      <header>
        <h1>{person.name}</h1>
        <p class="role">{person.role} · {person.place}</p>
        <p class="contact">
          <a href={`mailto:${person.email}`}>{person.email}</a>
          <span aria-hidden="true">·</span>
          <a href={person.github}>{bare(person.github)}</a>
          <span aria-hidden="true">·</span>
          <a href={person.linkedin}>{bare(person.linkedin)}</a>
          <span aria-hidden="true">·</span>
          <a href={`${site}/`}>{bare(site)}</a>
        </p>
        <p class="summary">{person.thesis}</p>
      </header>

      <section>
        <h2>Education</h2>
        <div class="entry">
          <div class="head">
            <h3>{education.degree}</h3>
            <span class="when">{education.period}</span>
          </div>
          <p class="org">{education.school}</p>
          <p class="note">{education.note}</p>
        </div>
      </section>

      <section>
        <h2>Experience</h2>
        {
          experience.map((r) => {
            const w = r.work ? byWork[r.work] : undefined;
            const points = w ? (pick[w.slug] ?? [0, 1]).map((i) => w.points[i]).filter(Boolean) : [];
            return (
              <div class="entry">
                <div class="head">
                  <h3>
                    {r.title} <span class="at">· {r.org}</span>
                  </h3>
                  <span class="when">{r.period}</span>
                </div>
                {points.length ? (
                  <ul>
                    {points.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                ) : (
                  <p class="note">{r.line}</p>
                )}
              </div>
            );
          })
        }
      </section>

      <section>
        <h2>Publications and talks</h2>
        {
          publications.map((p) => (
            <div class="entry">
              <h3 class="pub">{p.title}</h3>
              <p class="note">
                {p.venue}. {p.also}.{p.href && <> <a href={p.href}>{bare(p.href)}</a></>}
              </p>
            </div>
          ))
        }
      </section>

      <section>
        <h2>Projects</h2>
        <div class="entry">
          <div class="head">
            <h3>
              {intake.title} <span class="at">· {intake.stack.join(', ')}</span>
            </h3>
            <span class="when">{intake.period}</span>
          </div>
          <ul>
            {intake.points.slice(0, 2).map((p) => <li>{p}</li>)}
          </ul>
        </div>
        {
          moreProjects.map((p) => (
            <div class="entry tight">
              <div class="head">
                <h3>{p.title}</h3>
                <span class="when">{p.year}</span>
              </div>
              <p class="note">{p.line}</p>
            </div>
          ))
        }
      </section>

      <section>
        <h2>Skills</h2>
        <dl class="skills">
          {
            skills.map((g) => (
              <div>
                <dt>{g.group}</dt>
                <dd>{g.items.join(', ')}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 13mm 15mm;
  }

  :root {
    --ink: #11151f;
    --muted: #444b5c;
    --faint: #6b7286;
    --rule: #d6dae4;
    --accent: #1f4fd1;
    --teal: #0b6e66;
    --paper: #fff;
    color-scheme: light;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: #e9ecf2;
  }

  body {
    margin: 0;
    font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
    color: var(--ink);
    font-size: 9.6pt;
    line-height: 1.42;
    -webkit-font-smoothing: antialiased;
  }

  .sheet {
    width: 210mm;
    min-height: 297mm;
    margin: 24px auto;
    padding: 13mm 15mm;
    background: var(--paper);
    box-shadow: 0 6px 24px rgb(17 21 31 / 0.12);
  }

  h1,
  h2,
  h3,
  p,
  ul,
  dl,
  dd {
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  header {
    padding-bottom: 3.2mm;
    border-bottom: 1.5px solid var(--ink);
  }

  h1 {
    font-size: 23pt;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .role {
    margin-top: 1.6mm;
    font-size: 11pt;
    font-weight: 500;
  }

  .contact {
    margin-top: 1.4mm;
    font-size: 8.8pt;
    color: var(--muted);
  }

  .contact span {
    color: var(--faint);
    padding: 0 0.3em;
  }

  .contact a {
    color: var(--accent);
  }

  .summary {
    margin-top: 2mm;
    color: var(--muted);
  }

  section {
    margin-top: 3.6mm;
  }

  h2 {
    font-size: 8.6pt;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 1mm;
    border-bottom: 0.75px solid var(--rule);
    margin-bottom: 1.8mm;
    break-after: avoid;
    page-break-after: avoid;
  }

  /* Keep each section heading on the same page as its first entry. */
  h2 + .entry,
  h2 + dl {
    break-before: avoid;
    page-break-before: avoid;
  }

  .entry {
    break-inside: avoid;
  }

  .entry + .entry {
    margin-top: 2.2mm;
  }

  .entry.tight + .entry.tight {
    margin-top: 1.2mm;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4mm;
  }

  h3 {
    font-size: 9.8pt;
    font-weight: 600;
  }

  h3.pub {
    font-weight: 500;
  }

  .at {
    font-weight: 400;
    color: var(--muted);
  }

  .when {
    flex: none;
    font-size: 8.6pt;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .org,
  .note {
    color: var(--muted);
  }

  .note a {
    color: var(--accent);
  }

  ul {
    padding-left: 4.2mm;
    margin-top: 0.6mm;
  }

  li {
    color: var(--muted);
    padding-left: 0.6mm;
  }

  li + li {
    margin-top: 0.5mm;
  }

  li::marker {
    color: var(--teal);
  }

  .skills {
    display: grid;
    gap: 0.8mm;
  }

  .skills div {
    display: grid;
    grid-template-columns: 30mm 1fr;
    gap: 3mm;
  }

  dt {
    font-weight: 600;
  }

  dd {
    color: var(--muted);
  }

  @media screen and (max-width: 820px) {
    .sheet {
      width: auto;
      min-height: 0;
      margin: 0;
      padding: 8mm 6mm;
      box-shadow: none;
    }

    .head {
      flex-direction: column;
      gap: 0;
    }

    .skills div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  @media print {
    html {
      background: none;
    }

    .sheet {
      width: auto;
      min-height: 0;
      margin: 0;
      padding: 0;
      box-shadow: none;
    }
  }
</style>
